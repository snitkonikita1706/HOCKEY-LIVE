{
  "expo": {
    "name": "HOCKEY LIVE",
    "slug": "hockey-live-pro",
    "scheme": "hockeylive",
    "version": "4.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.snitko.hockeylive",
      "icon": "./assets/icon.png",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "HOCKEY LIVE"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070E1D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#070E1D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
